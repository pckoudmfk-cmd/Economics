# Copy this file's variable names into the Vercel project's
# Settings → Environment Variables (do not commit a real .env file).

# The PIN a teacher types on the login screen. Checked only inside
# api/teacher-login.js, never shipped to the browser.
TEACHER_PIN=choose-your-own-pin

# Base64-encoded contents of the Firebase service account JSON key
# (Firebase console → Project settings → Service accounts → Generate new
# private key). Encode it with, for example:
#   base64 -i service-account.json | tr -d '\n'
# then paste the single resulting line here.
FIREBASE_SERVICE_ACCOUNT_BASE64=
